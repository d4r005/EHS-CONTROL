{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": ".",
    "resolveJsonModules": true,
    "allowJs": true,
    "declaration": true
  },
  "include": ["*.ts", "types/**/*.d.ts", "tests/**/*.test.ts"],
  "exclude": ["node_modules", "dist", ".claude"]
}